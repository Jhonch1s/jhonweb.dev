---
const title = 'Jhon Guimaraens | Desarrollo web';
const description = 'Diseño y desarrollo sitios web para negocios desde Paysandú. Conocé mis proyectos y guardá mis datos de contacto.';
const canonical = new URL('/hola/', Astro.site).href;
---
<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#121413">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={canonical}>
    <meta name="description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_UY">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:site_name" content="Jhon Guimaraens">
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL('/social-preview.png', Astro.site).href}>
    <meta name="twitter:card" content="summary_large_image">
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="nfc-page">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <main class="nfc-shell" id="contenido">
      <header class="nfc-header">
        <a class="brand" href="/" aria-label="Jhon Guimaraens, ir al inicio">
          <span class="brand-mark" aria-hidden="true">JG<span>.</span></span>
          <span>Jhon Guimaraens</span>
        </a>
        <span class="nfc-location">Paysandú · Uruguay</span>
      </header>

      <section class="nfc-intro" aria-labelledby="nfc-title">
        <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> Desarrollo web para negocios</p>
        <h1 id="nfc-title">Una web que<br><em>explique bien</em><br>lo que hacés<span class="blink-dot">.</span></h1>
        <p class="nfc-lead">Soy Jhon. Diseño y desarrollo sitios web para negocios que quieren presentar mejor lo que hacen y facilitar el contacto con sus clientes.</p>
        <div class="nfc-actions">
          <a class="button button-primary" href="https://wa.me/59892756977">Hablemos por WhatsApp <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
          <a class="button button-outline" href="/jhon-guimaraens.vcf" download>Guardar mi contacto <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v15m-6-6 6 6 6-6" /></svg></a>
        </div>
      </section>

      <nav class="nfc-links" aria-label="Conocer mi trabajo">
        <a href="/proyectos/"><span>01 / Trabajo seleccionado</span><strong>Ver proyectos <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></strong></a>
        <a href="/servicios/"><span>02 / Lo que puedo hacer</span><strong>Conocer mis servicios <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></strong></a>
        <a href="mailto:jhoncforever@gmail.com"><span>03 / Contacto por correo</span><strong>Enviar un email <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></strong></a>
      </nav>

      <footer class="nfc-footer">
        <span>Diseño + desarrollo desde Paysandú</span>
        <a href="/">jhonweb.dev <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
      </footer>
    </main>
    <aside class="nfc-dock" aria-label="Contacto rápido">
      <span>¿Hablamos de tu web?</span>
      <a class="button button-primary" href="https://wa.me/59892756977">WhatsApp <svg class="nfc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
    </aside>
  </body>
</html>

<style>
  .nfc-icon { width: 16px; height: 16px; flex: none; }
  .nfc-actions .nfc-icon { width: 18px; height: 18px; }
  .nfc-page {
    min-height: 100svh;
    padding: 0 0 env(safe-area-inset-bottom);
    background: radial-gradient(ellipse at 50% 12%, rgb(217 240 103 / 7%), transparent 38%), var(--paper);
  }
  .nfc-shell { width: min(100% - 32px, 560px); min-height: 100svh; margin: 0 auto; padding-bottom: 24px; }
  .nfc-header { display: flex; min-height: 74px; align-items: center; justify-content: space-between; gap: 14px; border-bottom: 1px solid var(--line); }
  .nfc-header .brand { font-size: .84rem; }
  .nfc-header .brand-mark { width: 36px; height: 36px; }
  .nfc-location { color: var(--muted); font-size: .76rem; white-space: nowrap; }
  .nfc-intro { margin-block: 22px 18px; padding: clamp(24px, 7vw, 38px) clamp(20px, 6vw, 34px); border: 1px solid var(--line); border-radius: 0; background: linear-gradient(145deg, rgb(255 255 255 / 3%), transparent 56%), var(--surface); box-shadow: 0 18px 60px rgb(0 0 0 / 18%); }
  .nfc-intro .eyebrow { margin-bottom: 20px; color: var(--muted); font-size: .7rem; }
  .nfc-intro h1 { margin-bottom: 18px; font-size: clamp(2.8rem, 12.5vw, 4rem); line-height: .98; }
  .nfc-lead { max-width: 520px; margin-bottom: 24px; color: var(--muted); font-size: 1rem; line-height: 1.65; }
  .nfc-actions { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .nfc-actions .button { width: 100%; min-height: 56px; border-radius: 0; }
  .nfc-links { display: grid; gap: 10px; }
  .nfc-links a { display: flex; min-height: 74px; flex-direction: column; justify-content: center; gap: 6px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 0; background: rgb(255 255 255 / 2%); transition: border-color .2s ease, background .2s ease; }
  .nfc-links a:hover { border-color: var(--accent); background: var(--surface); }
  .nfc-links a > span { color: var(--muted); font-size: .72rem; letter-spacing: .07em; text-transform: uppercase; }
  .nfc-links strong { display: flex; align-items: center; justify-content: space-between; font-size: 1rem; }
  .nfc-footer { display: flex; justify-content: space-between; gap: 16px; padding: 22px 2px 8px; color: var(--muted); font-size: .73rem; }
  .nfc-footer a { color: var(--ink); }
  .nfc-footer a:hover { color: var(--accent); }
  .nfc-dock { display: none; }
  @media (min-width: 560px) {
    .nfc-shell { width: min(100% - 48px, 560px); padding-bottom: 36px; }
    .nfc-header { min-height: 82px; }
    .nfc-intro { margin-block: 32px 20px; padding: 40px; }
    .nfc-intro h1 { font-size: clamp(3.2rem, 8vw, 4.2rem); }
    .nfc-actions { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .nfc-shell { padding-bottom: calc(104px + env(safe-area-inset-bottom)); }
    .nfc-dock { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; min-height: 78px; align-items: center; justify-content: space-between; gap: 16px; padding: 10px max(16px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); border-top: 1px solid var(--line); background: rgb(18 20 19 / 94%); backdrop-filter: blur(16px); }
    .nfc-dock > span { color: var(--muted); font-size: .78rem; }
    .nfc-dock .button { min-height: 48px; padding: 12px 16px; border-radius: 0; white-space: nowrap; }
    .nfc-footer { padding-bottom: 6px; }
  }
  @media (max-width: 360px) {
    .nfc-shell { width: min(100% - 24px, 560px); }
    .nfc-header .brand { gap: 8px; font-size: .78rem; }
    .nfc-location { font-size: .7rem; }
    .nfc-intro { padding-inline: 16px; }
    .nfc-intro h1 { font-size: clamp(2.45rem, 12vw, 2.8rem); }
  }
  @media (max-height: 640px) and (max-width: 560px) {
    .nfc-intro { margin-top: 14px; padding-block: 22px; }
    .nfc-intro .eyebrow { margin-bottom: 14px; }
    .nfc-intro h1 { margin-bottom: 14px; }
    .nfc-lead { margin-bottom: 18px; line-height: 1.5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nfc-page { scroll-behavior: auto; }
    .nfc-page .blink-dot { animation: none; }
    .nfc-page a { transition: none; }
  }
</style>




