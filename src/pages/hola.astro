---
const title = 'Jhon Guimaraens | Desarrollo web';
const description = 'Diseño y desarrollo sitios web para negocios desde Paysandú. Conocé mis proyectos y guardá mis datos de contacto.';
const canonical = new URL('/hola/', Astro.site).href;
---
<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#121413">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={canonical}>
    <meta name="description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_UY">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:site_name" content="Jhon Guimaraens">
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL('/social-preview.png', Astro.site).href}>
    <meta name="twitter:card" content="summary_large_image">
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="nfc-page">
    <main class="nfc-shell" id="contenido">
      <header class="nfc-header">
        <a class="brand" href="/" aria-label="Jhon Guimaraens, ir al inicio">
          <span class="brand-mark" aria-hidden="true">JG<span>.</span></span>
          <span>Jhon Guimaraens</span>
        </a>
        <span class="nfc-location">Paysandú · Uruguay</span>
      </header>

      <section class="nfc-intro" aria-labelledby="nfc-title">
        <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> Desarrollo web para negocios</p>
        <h1 id="nfc-title">Una web que<br><em>explique bien</em><br>lo que hacés<span class="blink-dot">.</span></h1>
        <p class="nfc-lead">Soy Jhon. Diseño y desarrollo sitios web para negocios que quieren presentar mejor lo que hacen y facilitar el contacto con sus clientes.</p>
        <div class="nfc-actions">
          <a class="button button-primary" href="https://wa.me/59892756977">Hablemos por WhatsApp <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/jhon-guimaraens.vcf" download>Guardar mi contacto <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <nav class="nfc-links" aria-label="Conocer mi trabajo">
        <a href="/proyectos/"><span>01 / Trabajo seleccionado</span><strong>Ver proyectos <span aria-hidden="true">↗</span></strong></a>
        <a href="/servicios/"><span>02 / Lo que puedo hacer</span><strong>Conocer mis servicios <span aria-hidden="true">↗</span></strong></a>
        <a href="mailto:jhoncforever@gmail.com"><span>03 / Contacto por correo</span><strong>Enviar un email <span aria-hidden="true">↗</span></strong></a>
      </nav>

      <footer class="nfc-footer">
        <span>Diseño + desarrollo desde Paysandú</span>
        <a href="/">jhonweb.dev <span aria-hidden="true">↗</span></a>
      </footer>
    </main>
  </body>
</html>

<style>
  .nfc-page { min-height: 100svh; }
  .nfc-shell { width: min(100% - 40px, 680px); margin: 0 auto; }
  .nfc-header { display: flex; min-height: 78px; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--line); }
  .nfc-location { color: var(--muted); font-size: .76rem; }
  .nfc-intro { padding-block: clamp(56px, 10vh, 104px) 52px; }
  .nfc-intro .eyebrow { margin-bottom: 24px; color: var(--muted); }
  .nfc-intro h1 { margin-bottom: 22px; font-size: clamp(3.2rem, 13vw, 5.4rem); }
  .nfc-lead { max-width: 550px; margin-bottom: 30px; color: var(--muted); font-size: clamp(1.04rem, 3.5vw, 1.18rem); line-height: 1.65; }
  .nfc-actions { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .nfc-actions .button { width: 100%; }
  .nfc-links { border-top: 1px solid var(--line); }
  .nfc-links a { display: flex; min-height: 84px; flex-direction: column; justify-content: center; gap: 7px; border-bottom: 1px solid var(--line); transition: color .2s ease; }
  .nfc-links a:hover { color: var(--accent); }
  .nfc-links a > span { color: var(--muted); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .nfc-links strong { display: flex; align-items: center; justify-content: space-between; font-size: 1.08rem; }
  .nfc-footer { display: flex; justify-content: space-between; gap: 16px; padding-block: 24px 30px; color: var(--muted); font-size: .75rem; }
  .nfc-footer a { color: var(--ink); }
  .nfc-footer a:hover { color: var(--accent); }
  @media (min-width: 540px) {
    .nfc-shell { width: min(100% - 64px, 680px); }
    .nfc-actions { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nfc-page { scroll-behavior: auto; }
    .nfc-page .blink-dot { animation: none; }
  }
</style>
